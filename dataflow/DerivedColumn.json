{
	"name": "DerivedColumn",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText23",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText24",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          first_name as string,",
				"          last_name as string,",
				"          job_title as string,",
				"          dob as date,",
				"          email as string,",
				"          phone as string,",
				"          salary as integer,",
				"          department_id as short",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(country = 'India') ~> derivedColumn1",
				"derivedColumn1 filter(salary >=50000) ~> filter1",
				"filter1 derive(increased_salary = salary +100000) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(department_id),",
				"     new_department = sum(department_id) >=5) ~> aggregate1",
				"aggregate1 sort(asc(department_id, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}