{
	"name": "Transformations_12nov2025",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText27",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable13",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "filter2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "sort2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          employee_id as short,",
				"          first_name as string,",
				"          last_name as string,",
				"          gender as string,",
				"          age as short,",
				"          salary as double,",
				"          country as string,",
				"          department_id as short,",
				"          job_title as string,",
				"          hire_date as string,",
				"          email as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 filter(gender == 'Male') ~> filter1",
				"filter1 filter(age >30) ~> filter2",
				"filter2 aggregate(groupBy(department_id),",
				"     sum_salary = sum(salary)) ~> aggregate1",
				"aggregate1 sort(asc(department_id, true)) ~> sort1",
				"sort1 sort(asc(sum_salary, true)) ~> sort2",
				"sort2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}